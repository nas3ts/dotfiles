#!/bin/bash

# omarchy theme-set hook
# Generates kitty tab colors and vicinae theme from the current theme's colors.toml

COLORS_FILE="$HOME/.config/omarchy/current/theme/colors.toml"
KITTY_OUTPUT="$HOME/.config/kitty/kitty-tab-colors.conf"
VICINAE_THEME_FILE="$HOME/.config/vicinae/themes/kuroi.toml"

get_color() {
  grep -E "^[[:space:]]*$1[[:space:]]*=" "$COLORS_FILE" | head -1 | sed 's/.*= *"\(.*\)"/\1/'
}

# --- Kitty tab colors ---

cat > "$KITTY_OUTPUT" << EOF
# Auto-generated by omarchy theme-set hook
# Changes here will be overwritten on next theme switch

active_border_color $(get_color color8)
active_tab_background $(get_color color8)
inactive_tab_background $(get_color background)
active_tab_foreground $(get_color background)
inactive_tab_foreground $(get_color color8)
tab_bar_border_color $(get_color accent)
inactive_border_color $(get_color background)
EOF

# --- Vicinae theme ---

BG=$(get_color background)
FG=$(get_color foreground)
AC=$(get_color accent)
SF=$(get_color selection_foreground)
SB=$(get_color selection_background)
C0=$(get_color color0)
C1=$(get_color color1)
C2=$(get_color color2)
C3=$(get_color color3)
C4=$(get_color color4)
C5=$(get_color color5)
C6=$(get_color color6)
C8=$(get_color color8)

VICINAE_CONTENT="# Auto-generated by omarchy theme-set hook
# Changes here will be overwritten on next theme switch

[meta]
name = \"Kuroi\"
description = \"Generated from omarchy theme\"
variant = \"dark\"

[colors.core]
accent = \"$AC\"
accent_foreground = \"$FG\"
background = \"$BG\"
foreground = \"$FG\"
secondary_background = \"$C0\"
border = \"$C0\"

[colors.main_window]
border = \"$C0\"
footer = { background = \"$BG\" }

[colors.settings_window]
border = \"$C0\"

[colors.accents]
blue = \"$AC\"
green = \"$C2\"
magenta = \"$C5\"
orange = \"$C3\"
purple = \"$C5\"
red = \"$C1\"
yellow = \"$C3\"
cyan = \"$C6\"

[colors.shortcut]
border = \"$C0\"

[colors.text]
default = \"$FG\"
muted = \"$C8\"
danger = \"$C1\"
success = \"$C2\"
placeholder = \"$C8\"
selection = { background = \"$AC\", foreground = \"$SF\" }

[colors.text.links]
default = \"$AC\"
visited = \"$C5\"

[colors.input]
border = \"$C0\"
border_focus = \"$AC\"
border_error = \"$C1\"

[colors.button.primary]
background = \"$C0\"
foreground = \"$FG\"
hover = { background = \"${BG}33\" }
focus = { outline = \"$AC\" }

[colors.list.item.hover]
foreground = \"$FG\"
secondary_foreground = \"$C8\"

[colors.list.item.selection]
background = \"$SB\"
foreground = \"$SF\"
secondary_background = \"$SB\"
secondary_foreground = \"$SF\"

[colors.grid.item]
background = \"$C0\"
hover = { outline = \"$FG\" }
selection = { outline = \"$FG\" }

[colors.scrollbars]
background = \"$C0\"

[colors.loading]
bar = \"$AC\"
spinner = \"$FG\"
"

echo "$VICINAE_CONTENT" > "$VICINAE_THEME_FILE"
vicinae theme set kuroi >/dev/null 2>&1

# --- Dunst ---

DUNST_OUTPUT="$HOME/.config/dunst/dunstrc"

cat > "$DUNST_OUTPUT" << EOF
[global]
width = (0, 400)
height = (0, 400)
offset = (0, 5)
origin = top-center
frame_width = 1
corner_radius = 5
font = "JetBrains Mono Nerd Font 10"
background = "${BG}cc"
foreground = "$FG"
frame_color = "$AC"
timeout = 5

icon_position = left
enable_recursive_icon_lookup = true
icon_theme = Yamis

[urgency_low]
background = "${BG}cc"
foreground = "$C8"
frame_color = "$C0"

[urgency_normal]
background = "${BG}cc"
foreground = "$FG"
frame_color = "${AC}ee"

[urgency_critical]
background = "${BG}cc"
foreground = "$FG"
frame_color = "${C1}ee"
frame_width = 5
timeout = 20
EOF

killall dunst 2>/dev/null; dunst &>/dev/null &
