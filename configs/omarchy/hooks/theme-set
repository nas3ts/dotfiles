#!/bin/bash

# omarchy theme-set hook
# Generates kitty tab colors from the current theme's colors.toml

COLORS_FILE="$HOME/.config/omarchy/current/theme/colors.toml"
OUTPUT_FILE="$HOME/.config/kitty/kitty-tab-colors.conf"

get_color() {
  grep -E "^[[:space:]]*$1[[:space:]]*=" "$COLORS_FILE" | head -1 | sed 's/.*= *"\(.*\)"/\1/'
}

cat > "$OUTPUT_FILE" << EOF
# Auto-generated by omarchy theme-set hook
# Changes here will be overwritten on next theme switch

active_border_color $(get_color color8)
active_tab_background $(get_color color8)
inactive_tab_background $(get_color background)
active_tab_foreground $(get_color background)
inactive_tab_foreground $(get_color color8)
tab_bar_border_color $(get_color accent)
inactive_border_color $(get_color background)
EOF

# Reload kitty to pick up the new tab colors
killall -SIGUSR1 kitty >/dev/null
