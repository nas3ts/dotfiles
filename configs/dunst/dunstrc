[global]
width = (0, 400)
height = (0, 400)
offset = (0, 5)
origin = top-center
frame_width = 1
corner_radius = 5
font = "JetBrains Mono Nerd Font 10"
background = "#0d0d0dcc"
foreground = "#ffffff"
frame_color = "#3584e4"
timeout = 5

icon_position = left
enable_recursive_icon_lookup = true
icon_theme = Yamis

[urgency_low]
background = "#0d0d0dcc"
foreground = "#7f8c8d"
frame_color = "#1a1a1a"

[urgency_normal]
background = "#0d0d0dcc"
foreground = "#ffffff"
frame_color = "#3584e4ee"

[urgency_critical]
background = "#0d0d0dcc"
foreground = "#ffffff"
frame_color = "#e74c3cee"
frame_width = 5
timeout = 20
