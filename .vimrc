set number
syntax on
set cursorline
set mouse=a
set clipboard=unnamed,unnamedplus

highlight LineNr      cterm=NONE ctermfg=239  ctermbg=NONE guifg=#4e4e4e guibg=NONE
highlight CursorLineNr cterm=NONE ctermfg=214 ctermbg=NONE guifg=#ffaf00 guibg=NONE
highlight CursorLine  cterm=NONE ctermbg=235  guibg=#262626
